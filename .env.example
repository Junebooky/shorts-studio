# Copy to .env.local. Never commit a real key. Restart npm run dev.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Text generation for the topic-to-video button (server-only)
OPENAI_API_KEY=
SHORTS_DIRECTOR_MODEL=gpt-6.2-sol
# Optional alternative: local OpenAI-compatible model; configure its model name
SHORTS_DIRECTOR_LOCAL_URL=

# Gemini is preferred when configured; local URL still takes precedence.
GEMINI_API_KEY=
SHORTS_GEMINI_MODEL=gemini-4-hydrogen
