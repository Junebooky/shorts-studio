# Copy to .env.local. Never commit a real key. Restart npm run dev.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Text generation for the topic-to-video button (server-only)
OPENAI_API_KEY=
SHORTS_DIRECTOR_PROVIDER=openai
SHORTS_DIRECTOR_MODEL=gpt-6-luna
# Optional alternative: local OpenAI-compatible model; configure its model name
SHORTS_DIRECTOR_LOCAL_URL=

# Optional Gemini alternative: set SHORTS_DIRECTOR_PROVIDER=gemini.
# auto selects explicit local URL, then OpenAI, then Gemini by configured keys.
GEMINI_API_KEY=
SHORTS_GEMINI_MODEL=gemini-3.5-flash-lite
